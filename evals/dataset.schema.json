{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "question",
      "relevant_sections",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "relevant_sections": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "conceptual",
            "exact-term",
            "code",
            "syntax",
            "multi-section"
          ]
        }
      },
      "validation": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "unvalidated-sample",
              "human-validated"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
